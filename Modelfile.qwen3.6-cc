# Claude Code cannot pass num_ctx over /v1/messages, so bake it into a model copy.
#   ollama create qwen3.6-cc -f Modelfile.qwen3.6-cc
# 64K context: ~1.3 GiB more KV cache than 32K on this hybrid-attention model;
# check the GPU/CPU split with `ollama ps` after the first call.
FROM qwen3.6:35b-a3b
PARAMETER num_ctx 65536
