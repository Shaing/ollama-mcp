# Copy to .env in the directory where the server runs (existing env vars win).

# Where Ollama listens
OLLAMA_HOST=http://127.0.0.1:11434

# trio: qwen3.5 9B (strong) + qwen3.5 4B (fast) + qwen3-embedding, all resident on a 16 GB GPU
# big : qwen3.6:35b-a3b for both tiers (12 GiB on GPU, rest in RAM), embeddings on CPU
OLLAMA_AGENT_PROFILE=trio

# Override individual tiers (optional)
#OLLAMA_AGENT_STRONG_MODEL=qwen3.5:latest
#OLLAMA_AGENT_FAST_MODEL=qwen3.5:4b
#OLLAMA_AGENT_EMBED_MODEL=qwen3-embedding:0.6b

# Context window requested on every call (must be the same for all calls or Ollama reloads)
OLLAMA_AGENT_NUM_CTX=32768
OLLAMA_AGENT_KEEP_ALIVE=30m

# Output returned to Claude is clipped to this many chars; the full text is saved under DATA_DIR/outputs
OLLAMA_AGENT_MAX_RETURN_CHARS=10000
OLLAMA_AGENT_MAX_INPUT_CHARS=90000
OLLAMA_AGENT_MAX_TIMEOUT_S=600
OLLAMA_AGENT_MAX_CONCURRENCY=2

# Outputs and search indexes; defaults to $XDG_CACHE_HOME/ollama-agent (~/.cache/ollama-agent)
#OLLAMA_AGENT_DATA_DIR=

# Preload the profile's models at startup, largest first, so the 9B is never squeezed onto the CPU
OLLAMA_AGENT_WARMUP=1

OLLAMA_AGENT_LOG_LEVEL=INFO
